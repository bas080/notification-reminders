<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Top App Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/txt_app_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_header_title"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:letterSpacing="0.1" />

        <!-- Top Right Utility Actions -->
        <LinearLayout
            android:id="@+id/container_reminders_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_import_markdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/import_markdown"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:letterSpacing="0.1"
                android:paddingVertical="6dp"
                android:paddingHorizontal="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/btn_export_markdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/export_markdown"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:letterSpacing="0.1"
                android:paddingVertical="6dp"
                android:paddingHorizontal="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>

        <TextView
            android:id="@+id/btn_clear_logs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clear_logs"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/accent_danger"
            android:letterSpacing="0.1"
            android:paddingVertical="6dp"
            android:paddingHorizontal="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Navigation Tabs Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/btn_nav_reminders"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_reminders"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:letterSpacing="0.1"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:background="@color/divider_color" />

        <TextView
            android:id="@+id/btn_nav_logs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_logs"
            android:textSize="13sp"
            android:textStyle="normal"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.1"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_color"
        android:layout_marginBottom="12dp" />

    <!-- Reminders Main Content View -->
    <LinearLayout
        android:id="@+id/reminders_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Section Summary Header -->
        <TextView
            android:id="@+id/txt_reminders_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_active_reminders"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <!-- Filter & Sort Control Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Filter Options -->
            <TextView
                android:id="@+id/btn_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_all"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:letterSpacing="0.05"
                android:paddingVertical="4dp"
                android:paddingHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btn_filter_active"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_active"
                android:textSize="11sp"
                android:textStyle="normal"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.05"
                android:paddingVertical="4dp"
                android:paddingHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btn_filter_snoozed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_snoozed"
                android:textSize="11sp"
                android:textStyle="normal"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.05"
                android:paddingVertical="4dp"
                android:paddingHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Sort Option -->
            <TextView
                android:id="@+id/btn_sort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sort_button"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:letterSpacing="0.05"
                android:paddingVertical="4dp"
                android:paddingHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/reminders_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:listitem="@layout/item_reminder" />

            <TextView
                android:id="@+id/txt_empty_reminders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="80dp"
                android:gravity="center"
                android:text="@string/no_reminders"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- Logs Main Content View -->
    <LinearLayout
        android:id="@+id/logs_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_surface"
            android:padding="12dp">

            <TextView
                android:id="@+id/txt_logs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:lineSpacingExtra="3dp" />

        </ScrollView>

    </LinearLayout>

</LinearLayout>
